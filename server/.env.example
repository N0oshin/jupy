# Copy to .env alongside server/index.js

PORT=4001
BRAND_DOMAIN=jupyterlabs.net
ALLOWED_ORIGINS=https://jupyterlabs.net,http://localhost:5173

# Inbox that /api/contact submissions are delivered to.
CONTACT_TO=support@jupyterlabs.net

# Resend/SMTP credentials live in /var/www/shared-email/.env, not here —
# this process only needs the above to run its own endpoint.
